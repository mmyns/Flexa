# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
env/
venv/
ENV/

# Tooling caches
.ruff_cache/
.pytest_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# PyTorch / Hugging Face model caches
.cache/
checkpoints/
*.pt
*.pth
*.bin
*.safetensors

# Data and logs
# Raw inputs are never committed: supply them locally in data/raw before running.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
# Forecast outputs are regenerated by scripts/run_forecast.py.
# data/benchmarks/ is deliberately NOT ignored: the report renders it.
data/forecasts/*
!data/forecasts/.gitkeep
logs/
*.log

# marimo session caches
notebooks/__marimo__/

# Environment variables & secrets
.env
.env.local

# IDEs & OS
.DS_Store
.idea/
.vscode/
*.swp
