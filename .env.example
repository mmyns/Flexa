# Hugging Face token (optional, needed for gated models)
HF_TOKEN=

# Default Chronos Model:
# Examples: amazon/chronos-bolt-tiny, amazon/chronos-bolt-mini, amazon/chronos-bolt-small, amazon/chronos-bolt-base
# Or Chronos-2 checkpoints: amazon/chronos-2, etc.
CHRONOS_MODEL_ID=amazon/chronos-bolt-small

# Compute Device: auto, cpu, mps, cuda
DEVICE=auto

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
